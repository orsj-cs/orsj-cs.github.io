---
interface Props {
  title: string;
  date: Date;
  venue?: string;
  deadline?: Date;
  applyUrl?: string;
  featured?: boolean;
}
const { title, date, venue, deadline, applyUrl, featured = false } = Astro.props;

const y = date.getFullYear();
const m = date.getMonth() + 1;
const d = date.getDate();
const weekday = ["日", "月", "火", "水", "木", "金", "土"][date.getDay()];
const fmtDeadline = deadline
  ? `${deadline.getFullYear()}年${deadline.getMonth() + 1}月${deadline.getDate()}日`
  : null;
---

<article class:list={["event-card", { "event-card--featured": featured }]}>
  <div class="event-card__date">
    <span class="event-card__year">{y}</span>
    <span class="event-card__md">{m}/{d}</span>
    <span class="event-card__wd">（{weekday}）</span>
  </div>
  <div class="event-card__body">
    <h3 class="event-card__title">{title}</h3>
    <dl class="event-card__meta">
      {
        venue && (
          <div>
            <dt>会場</dt>
            <dd>{venue}</dd>
          </div>
        )
      }
      {
        fmtDeadline && (
          <div>
            <dt>申込締切</dt>
            <dd>{fmtDeadline}</dd>
          </div>
        )
      }
    </dl>
    {
      applyUrl && (
        <a class="btn" href={applyUrl}>
          参加申込・詳細 ›
        </a>
      )
    }
  </div>
</article>
